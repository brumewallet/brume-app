# PostHog project API key (public, starts with phc_). Leave empty to build with analytics off.
# Users must still opt in on the Welcome screen or in Settings.
VITE_POSTHOG_KEY=

# Brume API origin. Empty means https://brume.cash. For a local API (cd app && pnpm dev):
# put VITE_BRUME_API_ORIGIN=http://localhost:3000 in .env.development (used by pnpm dev only).
VITE_BRUME_API_ORIGIN=
